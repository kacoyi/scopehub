{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scopehub.local/schemas/project.schema.json",
  "$defs": {
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "milestone": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "active",
            "blocked",
            "done",
            "cancelled"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        },
        "next_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocker": {
          "type": [
            "string",
            "null"
          ]
        },
        "closure_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "$ref": "#/$defs/TaskPlan"
        }
      },
      "required": [
        "id",
        "title",
        "milestone",
        "status",
        "depends_on",
        "scope",
        "decision_refs",
        "acceptance",
        "checks",
        "evidence",
        "next_action",
        "blocker",
        "closure_reason"
      ],
      "additionalProperties": false
    },
    "TaskLedger": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "focus_task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Task"
          }
        }
      },
      "required": [
        "schema_version",
        "focus_task_id",
        "tasks"
      ],
      "additionalProperties": false
    },
    "Check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "status": {
          "enum": [
            "implemented",
            "planned",
            "retired"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "platforms": {
          "enum": [
            "all",
            "windows-x64"
          ]
        },
        "command": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "cadence": {
          "enum": [
            "change",
            "release"
          ]
        }
      },
      "required": [
        "id",
        "status",
        "purpose",
        "platforms",
        "command",
        "timeout_seconds"
      ],
      "additionalProperties": false
    },
    "CheckCatalog": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Check"
          }
        },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "id",
              "checks"
            ],
            "additionalProperties": false
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "requirement",
              "checks"
            ],
            "additionalProperties": false
          }
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "required": [
        "schema_version",
        "checks",
        "milestones",
        "acceptance"
      ],
      "additionalProperties": false
    },
    "Decision": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "rejected"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date"
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "option": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "option",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "consequences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "revisit_when": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "status",
        "recorded_at",
        "context",
        "decision",
        "authority",
        "alternatives",
        "consequences",
        "supersedes",
        "revisit_when"
      ],
      "additionalProperties": true
    },
    "Source": {
      "type": "object",
      "properties": {
        "snapshot_kind": {
          "const": "execution-inputs-v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "git_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "working_tree_dirty": {
          "type": "boolean"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "snapshot_kind",
        "sha256",
        "file_count",
        "git_head",
        "working_tree_dirty",
        "exclusions"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "task_definition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment": {
          "type": "object"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "passed"
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exit_code": {
                "const": 0
              },
              "log_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "status",
              "command",
              "exit_code",
              "log_sha256"
            ],
            "additionalProperties": false
          }
        },
        "claim_scope": {
          "const": "Completed task at the recorded execution inputs; not a release or current-worktree guarantee."
        },
        "project_definition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "task_definition_sha256",
        "run_id",
        "recorded_at",
        "source",
        "report_sha256",
        "environment",
        "checks",
        "claim_scope"
      ],
      "additionalProperties": false
    },
    "TaskPlan": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "change_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "failure": {
                "type": "string",
                "minLength": 1
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "failure",
              "checks"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "outcome",
        "change_types",
        "context",
        "hypotheses",
        "risks",
        "rollback"
      ],
      "additionalProperties": false
    },
    "Delivery": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "iteration_policy": {
          "type": "object",
          "properties": {
            "start": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "during": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "finish": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "adaptation": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "start",
            "during",
            "finish",
            "adaptation"
          ],
          "additionalProperties": false
        },
        "change_types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "triggers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "triggers",
              "checks"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "task_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "user_goal": {
                "type": "string",
                "minLength": 1
              },
              "given": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "type": "string",
                "minLength": 1
              },
              "then": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "failure_cases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "evidence_boundary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "task_ids",
              "user_goal",
              "given",
              "when",
              "then",
              "failure_cases",
              "checks",
              "evidence_boundary"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "release_policy": {
          "type": "object",
          "properties": {
            "required_milestones": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "required_checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "artifact_requirements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "product_review": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "required_milestones",
            "required_checks",
            "artifact_requirements",
            "product_review"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "context",
        "iteration_policy",
        "change_types",
        "scenarios",
        "release_policy"
      ],
      "additionalProperties": false
    },
    "Feedback": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "observation": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "critical",
                  "major",
                  "minor"
                ]
              },
              "status": {
                "enum": [
                  "open",
                  "addressed",
                  "deferred"
                ]
              },
              "task_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "regression_checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "resolution": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "cause": {
                        "type": "string",
                        "minLength": 1
                      },
                      "correction": {
                        "type": "string",
                        "minLength": 1
                      },
                      "prevention": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "cause",
                      "correction",
                      "prevention"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "deferral_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "source",
              "observation",
              "severity",
              "status",
              "task_ids",
              "regression_checks",
              "resolution",
              "deferral_reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "items"
      ],
      "additionalProperties": false
    },
    "HarnessReport": {
      "type": "object",
      "properties": {
        "report_version": {
          "const": "2.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "source_unchanged": {
          "type": "boolean"
        },
        "project_definition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "project_unchanged": {
          "type": "boolean"
        },
        "task_definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "environment": {
          "type": "object",
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "machine": {
              "type": "string",
              "minLength": 1
            },
            "python_executable": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "system",
            "machine",
            "python_executable"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "blocked"
                ]
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "log": {
                "type": "string",
                "minLength": 1
              },
              "log_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "status",
              "command"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "passed"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "exit_code": {
                      "const": 0
                    }
                  },
                  "required": [
                    "exit_code",
                    "log",
                    "log_sha256"
                  ]
                }
              }
            ]
          }
        }
      },
      "required": [
        "report_version",
        "run_id",
        "status",
        "source",
        "source_unchanged",
        "project_definition_sha256",
        "project_unchanged",
        "task_definitions",
        "environment",
        "checks"
      ]
    }
  }
}
